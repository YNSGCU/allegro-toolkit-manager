# Allegro env - existing ATM managed block
# Testing: 已有 ATM 托管块时的替换逻辑

set autosave = 1

funckey F1 add connect
funckey F2 done
funckey F3 cancel

# ===== ATM Managed Hotkeys Start =====
funckey F8 autoFanout
funckey F9 showNetLength
alias zs zoom selection
alias sa save_as
# ===== ATM Managed Hotkeys End =====

alias s save
alias zc zoom center
