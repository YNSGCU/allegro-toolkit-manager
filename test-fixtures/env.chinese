# Allegro env file - 中文注释和非 ASCII 字符
# 用户: 张三（测试用户）
# 创建日期: 2026-06-22

set autosave = 1

# 功能快捷键 —— 中文说明
funckey F1 add connect    ; 添加连接
funckey F2 done            ; 完成操作
funckey F3 cancel          ; 取消

# 自定义快捷键 —— 我的个人设置
funckey F8 autoFanout      ; 自动扇出（测试中文注释）
funckey F9 showNetLength   ; 显示网络长度

# 命令别名 —— 中文路径支持
alias zs zoom selection    ; 缩放到选择
alias zc zoom center       ; 缩放到中心
alias s save               ; 保存（使用中文注释）
alias sa save_as           ; 另存为

# 路径测试：D:\用户目录\PCB 项目（带空格和中文）
set working_dir = D:\用户目录\PCB 项目
