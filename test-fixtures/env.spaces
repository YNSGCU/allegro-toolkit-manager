# Allegro env - paths with spaces
# Testing: 路径含空格、特殊字符

set autosave = 1

funckey F1 add connect
funckey F2 done
funckey F8 autoFanout       ; 这是个带空格路径的注释

# 带空格路径
set working_dir = C:\Users\PCB User\projects
set skill_dir = D:\Cadence SPB Data\skill

alias s save
alias zs zoom selection
alias wd working_dir        ; 切换工作目录
