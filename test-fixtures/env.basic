# Allegro env file - basic sample
# Allegro PCB Editor environment settings

set autosave = 1
set autosave_name = autosave

# Function keys
funckey F1 add connect
funckey F2 done
funckey F3 cancel
funckey F4 zoom in
funckey F5 zoom out
funckey F8 autoFanout
funckey F9 showNetLength

# Aliases
alias zs zoom selection
alias zc zoom center
alias zf zoom fit
alias s save
alias sa save_as
alias rp repour
