+import { describe, expect, it } from 'vitest';
+import { render, screen } from '@testing-library/react';
+import { MemoryRouter } from 'react-router-dom';
+import Layout from '../src/components/Layout';
+import MinimalSurface from '../src/components/MinimalSurface';
+import { APP_NAV_ITEMS } from '../src/config/appShell';
+
+describe('layout shell', () => {
+  it('renders the lightweight marvis shell with grouped navigation labels', () => {
+    const { container } = render(
+      <MemoryRouter initialEntries={['/hotkeys']}>
+        <Layout>
+          <div>page</div>
+        </Layout>
+      </MemoryRouter>,
+    );
+
+    expect(container.querySelector('.marvis-shell')).toBeInTheDocument();
+    expect(container.querySelector('.marvis-sidebar')).toBeInTheDocument();
+    expect(container.querySelector('.marvis-main')).toBeInTheDocument();
+
+    expect(screen.getByText(APP_NAV_ITEMS[0].label)).toBeInTheDocument();
+    expect(screen.getByText(APP_NAV_ITEMS[1].label)).toBeInTheDocument();
+    expect(screen.getByText(APP_NAV_ITEMS[2].label)).toBeInTheDocument();
+    expect(screen.getByText(APP_NAV_ITEMS[3].label)).toBeInTheDocument();
+    expect(screen.getByText(APP_NAV_ITEMS[4].label)).toBeInTheDocument();
+    expect(screen.getByText('核心模块')).toBeInTheDocument();
+    expect(screen.getByText('辅助模块')).toBeInTheDocument();
+    expect(screen.queryByText('Allegro Workspace')).not.toBeInTheDocument();
+  });
+});
+
+describe('minimal surface', () => {
